# Copy this file to backend/.env, edit deployment values, then run:
# python backend/security_setup.py
# python backend/security_setup.py --add-user operator
# See README.md for platform commands, role management, and shared HTTPS hosting.

# Authentication: local or ldap. Missing/other values deny authenticated workflows.
AUTH_METHOD=local
# Generated by security_setup.py; do not use a placeholder signing key.
SESSION_SECRET=
# Keep true for shared hosting. Set exactly false only for loopback-only HTTP.
SESSION_HTTPS_ONLY=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Listener settings for quickstart only; direct Uvicorn uses --host and --port.
# APP_HOST is honored by the Python helper; PowerShell binds to loopback.
APP_HOST=127.0.0.1
API_PORT=8000

# Required for Mist workflows. Choose the correct regional HTTPS API origin.
MIST_TOKEN=change_me
MIST_BASE_URL=https://api.ac2.mist.com
# Default organization; set explicitly before organization onboarding-policy sync.
MIST_ORG_ID=
# Network template used to obtain switch port profiles.
SWITCH_TEMPLATE_ID=
# Additional approved Mist API hostnames, comma-separated, without scheme/port.
MIST_ALLOWED_HOSTS=
HELP_URL=https://github.com/ejstover/GreatMigration/blob/main/README.md

# Local hash-only accounts; relative to backend/. Create users before app startup.
LOCAL_USERS_FILE=data/local_users.json
# Legacy LOCAL_USERS and LOCAL_PUSH_USERS are migrated by security_setup.py.
# Use --add-user USERNAME [--push]; do not add plaintext credentials here.

# LDAP mode: set AUTH_METHOD=ldap above, uncomment settings, replace all examples.
# Verified LDAPS and a working service account are required for session checks.
# LDAP_SERVER_URL=ldaps://dc01.example.org:636
# LDAP_SEARCH_BASE=DC=example,DC=org
# Multiple search bases use semicolons/newlines; commas remain part of each DN.
# LDAP_SEARCH_BASES=DC=example,DC=org;DC=branch,DC=example,DC=org
# LDAP_BIND_TEMPLATE={username}@example.org
# LDAP_SERVICE_DN=CN=GreatMigration,OU=Services,DC=example,DC=org
# LDAP_SERVICE_PASSWORD=change_me
# Configure allowed groups deliberately. Push membership grants write access.
# PUSH_GROUP_DN=CN=NetAuto-Push,OU=Groups,DC=example,DC=org
# READONLY_GROUP_DN=CN=NetAuto-ReadOnly,OU=Groups,DC=example,DC=org
# LDAP_MATCHING_RULE_IN_CHAIN=true
# Optional trusted corporate CA bundle; use an absolute path for your platform.
# LDAP_CA_CERTS_FILE=C:/certificates/corporate-ca.pem

# Lifecycle preservation adds IDs/ranges to built-in 10,500-599; cannot subtract.
LEGACY_VLANS=10,500-599
# Suppress legacy_ naming prefixes for these VLANs; does NOT omit output VLANs.
EXCLUDE_VLANS=
# Additional/overridden reserved VLAN names: comma-separated id:name pairs.
RESERVED_VLANS=1:vlan1

# Blank/invalid patterns fall back to built-in naming conventions.
SWITCH_NAME_REGEX_PATTERN=
AP_NAME_REGEX_PATTERN=
# Required site variable names. Supply approved key=value defaults only when the
# missing-variable fix should populate them. Bare keys have no fix default.
MIST_SITE_VARIABLES=hubradiusserver,localradiusserver,siteDNS,hubDNSserver1,hubDNSserver2
# Firmware baselines come from backend/standard_fw_versions.json, refreshed by
# Standards/audit workflows. Current filters: switches junos_suggested; APs alpha.
# Documentation image minimums; non-negative integers (0 permits no images).
SW_NUM_IMG=2
AP_NUM_IMG=2
TZ=America/New_York

# Online vendor model list; physical-port discovery also uses built-in GitHub URLs.
NETBOX_DT_URL=https://api.github.com/repos/netbox-community/devicetype-library/contents/device-types
# Optional vendor-to-model-list JSON; relative to server working directory.
# Set a writable file with an existing parent to enable custom model saves.
NETBOX_LOCAL_DT=

# Optional UDP syslog. Use Uvicorn --env-file backend/.env before module imports.
SYSLOG_HOST=
SYSLOG_PORT=514
# SSH keys must be verified out of band before collection. Empty uses normal
# service-account known-hosts; this adds a verified file (prefer absolute path).
SSH_KNOWN_HOSTS_FILE=
# Optional SQLite path override; default backend/data/security.sqlite3.
# Relative overrides use the working directory; prefer an absolute path.
# SECURITY_DB_PATH=C:/GreatMigration-private/security.sqlite3

# Positive resource limits. Login has a fixed separate 8 KiB body limit.
MAX_REQUEST_BYTES=16777216
MAX_INFLIGHT_REQUESTS=8
MAX_SSH_JOBS=2
# Saved conversion sets/snapshots only, by modification age; minimum one day.
# Does not rotate logs, remove accounts/policy/exceptions, or set session lifetime.
NETWORK_DATA_RETENTION_DAYS=30
